rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 정보 - 모든 인증된 사용자가 목록 조회 가능, 자신의 문서만 생성/수정
    match /users/{userId} {
      allow read: if request.auth != null; // 모든 사용자 정보 읽기 허용 (목록 조회 포함)
      allow create, update: if request.auth != null && request.auth.uid == userId; // 자신의 문서만 생성/수정
      allow delete: if request.auth != null && request.auth.uid == userId; // 자신의 문서만 삭제
    }

    // 사용자 컬렉션 쿼리 권한
    match /users {
      allow read: if request.auth != null;
    }

    // 강좌 - 모두 읽을 수 있고, 인증된 사용자가 쓸 수 있음
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 리뷰 - 모두 읽을 수 있고, 인증된 사용자가 쓸 수 있음
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 상담 신청 - 모두 생성 가능, 인증된 사용자만 관리 가능
    match /consultations/{consultationId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 레벨 테스트 - 모두 생성 가능, 인증된 사용자만 읽을 수 있음
    match /level_tests/{testId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // 기본 규칙 - 인증된 사용자만 모든 데이터 접근 가능
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
