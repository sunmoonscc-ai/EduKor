rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 정보 - 자신의 문서는 읽고 쓸 수 있음
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null; // 다른 사용자 정보도 읽기 허용
    }

    // 강좌 - 모두 읽을 수 있고, 인증된 사용자가 쓸 수 있음
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 리뷰 - 모두 읽을 수 있고, 인증된 사용자가 쓸 수 있음
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 상담 신청 - 모두 생성 가능, 인증된 사용자만 관리 가능
    match /consultations/{consultationId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 레벨 테스트 - 모두 생성 가능, 인증된 사용자만 읽을 수 있음
    match /level_tests/{testId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // 기본 규칙 - 인증된 사용자만 모든 데이터 접근 가능
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
